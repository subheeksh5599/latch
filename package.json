    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "tsx": "4.16.2",
    "typescript": "5.5.4"
  }
}
