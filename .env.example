# Path to the Kane CLI binary
KANE_CLI_PATH=kane-cli
# Max ms for a single Kane run
KANE_TIMEOUT=180000
# Run Kane's browser headless
KANE_HEADLESS=true
# Base URL Kane opens pages against (the locally-served preview)
PREVIEW_BASE_URL=http://localhost:3000
# Where signed receipts are written
RECEIPT_DIR=./data/receipts
# Secret used to sign receipts (host env only, never commit a real value)
RECEIPT_SECRET=change-me-in-host-env
# Optional: Slack / Discord / generic webhook fired on every green publish
PUBLISH_WEBHOOK_URL=
# Optional: HMAC secret so the receiver can verify the webhook came from Latch
PUBLISH_WEBHOOK_SECRET=
